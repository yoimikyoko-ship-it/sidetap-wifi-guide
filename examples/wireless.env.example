# Documentation only: requires the local wireless extension.
# The upstream default installation does not apply this extension by itself.
SIDETAP_TRANSPORT=wifi
SIDETAP_UDID=YOUR_DEVICE_UDID
SIDETAP_WIFI_ADDRESS=YOUR_PHONE_IPV4
USBMUXD_SOCKET_ADDRESS=127.0.0.1:27017
WDA_REFRESH_SESSION_ON_IDLE=0
AUTO_HEAL_ENABLED=0
SEND_APPROVAL=always
# Keep credentials and phone passcode out of shared files.
